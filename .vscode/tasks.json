{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-push website changes",
      "type": "process",
      "command": "node",
      "args": ["scripts/auto-push.mjs"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "auto-push",
        "pattern": {
          "regexp": "^Auto-push: error: (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Auto-push: watching",
          "endsPattern": "^Auto-push: stopped"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}